{
  "display_information": {
    "name": "slack-lab",
    "description": "Slack 이벤트를 트리거로 AI가 답하는 학습용 봇"
  },
  "features": {
    "bot_user": {
      "display_name": "slack-lab",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:write",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://your-ngrok-host.example.com/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
