#!/bin/sh
# 공개 저장소라 push 후에는 지울 수 없다. 스테이징된 추가 줄만 검사한다 (AGENTS.md Git 규칙).
# 활성화: git config core.hooksPath .githooks
diff=$(git diff --cached -U0 --no-color) || {
  # 검사를 못 한 채 통과시키면 훅이 없는 것과 같다
  echo "pre-commit: git diff 실행에 실패해 검사를 중단한다." >&2
  exit 1
}

# 파이프 대신 awk 한 번으로 처리한다. 파이프는 앞 단계의 오류가 마지막 단계 종료 코드에 가려진다.
# 파일 헤더는 'diff --git'부터 첫 '@@'까지로 판단한다. 접두사('+++ ')로 판단하면 내용이 '++ '로 시작하는 추가 줄을 놓친다.
count=$(printf '%s\n' "$diff" | awk '
  /^diff --git / { header = 1; next }
  /^@@ /         { header = 0; next }
  header         { next }
  /^\+/ && /xox[abpors]-[A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-]|xapp-[A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-][A-Za-z0-9-]|\/Users\/[A-Za-z]|\/home\/[a-z]/ { n++ }
  END { print n + 0 }
') || {
  echo "pre-commit: 검사 중 오류가 발생했다." >&2
  exit 1
}

# macOS가 만드는 복제 파일("Foo 2.java")이 git add -A에 딸려 올라간 적이 있다(M19·언어 방어 PR). 이름으로 막는다.
dups=$(git diff --cached --name-only --diff-filter=AM | grep -E ' [0-9]+(\.[A-Za-z]+)?$' || true)
if [ -n "$dups" ]; then
  echo "pre-commit: 복제 파일로 보이는 이름이 스테이징돼 있다(예: 'Foo 2.java'). 지우고 다시 커밋한다." >&2
  printf '%s\n' "$dups" >&2
  exit 1
fi

# 6단계: 구조화 로그·세션 장부·비밀 파일이 있는 .runtime/은 어떤 경우에도 커밋하지 않는다.
runtime=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)\.runtime/' || true)
if [ -n "$runtime" ]; then
  echo "pre-commit: .runtime/ 아래 파일이 스테이징돼 있다(로그·세션 장부·비밀). 지우고 다시 커밋한다." >&2
  exit 1
fi

# 6단계 M45: .env에만 있어야 할 관리 토큰·Grafana 관리자 비밀번호가 값과 함께 스테이징되면 막는다(키 이름만 있는 예시는 통과).
mgmt=$(printf '%s\n' "$diff" | awk '
  /^diff --git / { header = 1; next }
  /^@@ /         { header = 0; next }
  header         { next }
  /^\+(MANAGEMENT_METRICS_TOKEN|GRAFANA_ADMIN_PASSWORD)=[^ \t]/ { n++ }
  END { print n + 0 }
') || mgmt=1
if [ "$mgmt" -gt 0 ]; then
  echo "pre-commit: MANAGEMENT_METRICS_TOKEN 또는 GRAFANA_ADMIN_PASSWORD에 값이 들어간 줄이 스테이징돼 있다. 값은 출력하지 않는다." >&2
  exit 1
fi

if [ "$count" -gt 0 ]; then
  echo "pre-commit: 토큰 또는 로컬 절대경로로 보이는 줄이 스테이징돼 있다. 값은 출력하지 않고 개수만 표시한다." >&2
  echo "  해당 추가 줄 ${count}개" >&2
  echo "의도한 내용이면 git commit --no-verify 로 우회하되 git diff --cached 로 직접 확인한다." >&2
  exit 1
fi
