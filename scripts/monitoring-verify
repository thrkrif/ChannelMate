def cmd_stub(argv):
    import _mon_spike as ms
    import _mon_stubs
    opts = dict(zip(argv[1::2], argv[2::2]))
    if argv[:1] == ["metrics"] and "--port" in opts and "--token-file" in opts:
        with open(opts["--token-file"], encoding="utf-8") as f:
            token = f.read().strip()
        stub = ms.MetricsStub(int(opts["--port"]), token)
        stub.start(opts.get("--mode", "ok"))
    elif argv[:1] == ["webhook"] and "--port" in opts:
        stub = ms.WebhookStub(int(opts["--port"]))
        stub.start()
    elif argv[:1] == ["slack"] and "--port" in opts:
        stub = _mon_stubs.SlackRecorder(int(opts["--port"]), host=opts.get("--host", "127.0.0.1")).start()
    elif argv[:1] == ["llm"] and "--port" in opts:
        stub = _mon_stubs.LlmStub(int(opts["--port"]), model=opts.get("--model", "stub-model")).start()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        stub.stop()
    return 0


def _opt(argv, name, default=None):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else default


def find_session(project):
    prefix = "slack-lab-s6v-"
    if not project.startswith(prefix):
        return None
    sid = project[len(prefix):]
    root = os.environ.get("S6_SESSION_ROOT") or os.path.join(ROOT, ".runtime", "s6")
    if not os.path.isdir(root):
        return None
    cands = sorted(d for d in os.listdir(root) if d.lower().startswith(sid + "-"))
    return os.path.join(root, cands[-1]) if cands else None


def cmd_run(argv):
    import _mon_model as model
    mode, scen = _opt(argv, "--mode"), _opt(argv, "--scenario")
    try:
        repeat = int(_opt(argv, "--repeat", "5"))
    except ValueError:
        return model.EXIT_USAGE
    if mode not in ("host", "app") or scen not in model.SCENARIOS or repeat < 1:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return model.EXIT_USAGE
    rule, need_mode, variant = model.SCENARIOS[scen]
    if need_mode != mode:
        print(f"시나리오 {scen}는 --mode {need_mode}에서만 실행한다(규칙 파일이 모드별이다).", file=sys.stderr)
        return model.EXIT_USAGE
    plan = model.build_plan(scen, repeat)
    if "--dry-run" in argv:
        print(json.dumps({"scenario": scen, "mode": mode, "rule": rule, "plan": [{"variant": v, "h": h} for v, h in plan],
                          "reset_wait_s": model.RULE_RESET_WAIT_S, "deadline_s": model.RULES[rule]["deadline"] if rule else None},
                         ensure_ascii=False, indent=2))
        return model.EXIT_OK
    if scen == "dashboard":
        sdir = _opt(argv, "--session") or os.environ.get("S6_SESSION")
        if not sdir or not os.path.isdir(sdir):
            return model.EXIT_USAGE
        import _mon_dash
        import _mon_env
        import _mon_spike
        env_file = _mon_env.read_env_file(os.path.join(ROOT, ".env"))
        graf = _mon_spike.Grafana(env_file.get("GRAFANA_ADMIN_PASSWORD", ""))
        return _mon_dash.run(ROOT, sdir, graf)
    if mode == "app" and scen != "app-stop" and rule not in ("rule4-block", "rule4-absent"):
        return model.EXIT_USAGE
    if mode == "host" and rule not in ("rule1", "rule2", "rule3"):
        print("호스트 모드의 실행 범위는 규칙 ①②③이다.", file=sys.stderr)
        return model.EXIT_USAGE
    import _mon_env
    import _mon_spike as ms
    sdir = _opt(argv, "--session") or os.environ.get("S6_SESSION")
    if not sdir or not os.path.isdir(sdir):
        print("세션이 필요하다: --session <디렉터리>(먼저 session start).", file=sys.stderr)
        return model.EXIT_USAGE
    env_file = _mon_env.read_env_file(os.path.join(ROOT, ".env"))
    password = env_file.get("GRAFANA_ADMIN_PASSWORD", "")
    graf = ms.Grafana(password)
    if not graf.healthy():
        print("Grafana에 접속할 수 없다(모니터링 스택이 떠 있어야 한다).", file=sys.stderr)
        return model.EXIT_FAIL
    with open(os.path.join(ROOT, "infra", "monitoring", "grafana", "provisioning", "alerting", "rules-%s.json" % mode), encoding="utf-8") as stream:
        docs = [json.load(stream)]
    code, api = graf.request("GET", "/api/v1/provisioning/alert-rules")
    problems = model.parity(model.rules_from_files(docs), api if code == 200 and isinstance(api, list) else [])
    if problems:
        print("규칙·지속 시간 불일치(exit 3): " + "; ".join(problems), file=sys.stderr)
        return model.EXIT_RULES
    import _mon_alarm
    import _mon_run
    try:
        if mode == "app":
            import _mon_app
            env = _mon_app.AppSession(sdir).real_env()
            if scen == "app-stop":
                code, results = _mon_app.run_app_stop(env)
            else:
                code, results = _mon_run.run_rounds(env, rule, plan)
        else:
            session = _mon_alarm.AlarmSession(sdir, sys.modules.get(__name__))
            env = session.real_env()
            code, results = _mon_run.run_rounds(env, rule, plan)
    except (OSError, ValueError, RuntimeError, NotImplementedError) as e:
        # 원인을 모르면 세션 한 번(수 시간)을 다시 써야 해서 예외 종류와 메시지를 남긴다(우리 코드의 메시지라 비밀값은 없다).
        print(f"run 실패: {type(e).__name__}: {str(e)[:300]}", file=sys.stderr)
        code, results = model.EXIT_FAIL, [{"verdict": "induction", "reason": f"알람 세션 실행 실패({type(e).__name__}: {str(e)[:200]})"}]
    out = _opt(argv, "--out", os.path.join(sdir, "run-" + scen + ".json"))
    with open(out, "w", encoding="utf-8") as stream:
        json.dump({"scenario": scen, "exit": code, "results": results}, stream, ensure_ascii=False, indent=2)
    return code


def cmd_alarm_up(argv):
    import _mon_alarm
    sdir = _opt(argv, "--session") or os.environ.get("S6_SESSION")
    if not sdir or not os.path.isfile(os.path.join(sdir, "ledger.json")):
        return 2
    try:
        return _mon_alarm.AlarmSession(sdir, sys.modules.get(__name__)).up()
    except (OSError, ValueError, RuntimeError):
        print("B3 환경 준비 실패(세부 비밀값은 출력하지 않음).", file=sys.stderr)
        return 1


def cmd_override(argv):
    sdir = _opt(argv, "--session")
    name = _opt(argv, "--name")
    if not sdir or not name or not os.path.isdir(sdir):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    path = os.path.join(sdir, name)
    if "--remove" in argv:
        if os.path.exists(path):
            os.remove(path)
        print("삭제함")
        return 0
    extra = [a for i, a in enumerate(argv) if i > 0 and argv[i - 1] == "--env" and "=" in a]
    print(write_override(sdir, name, [f"{k}: \"{v}\"" for k, _, v in (e.partition("=") for e in extra)]))
    return 0


def cmd_session(argv):
    import _mon_model as model
    if argv[:1] == ["start"]:
        sid = _opt(argv, "--id")
        if not sid:
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
        args = ["start", "--id", sid] + (["--keep-volumes"] if "--keep-volumes" in argv else [])
        sdir = s6(*args).stdout.strip()
        subprocess.run(["./gradlew", "bootJar", "-x", "test", "-q"], cwd=ROOT, check=True, capture_output=True)
        libs = os.path.join(ROOT, "build", "libs")
        jar = pick_jar(libs)
        import hashlib
        sha = hashlib.sha256(open(jar, "rb").read()).hexdigest()
        with open(os.path.join(sdir, "jar.json"), "w", encoding="utf-8") as f:
            json.dump({"jar": jar, "sha256": sha}, f)
        print(sdir)
        return 0
    if argv[:1] == ["calibrate"]:
        rule, raw = _opt(argv, "--rule"), _opt(argv, "--samples")
        if rule not in model.RULES or not raw:
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
        try:
            samples = [tuple(float(x) for x in item.split(",")) for item in raw.split(";")]
        except ValueError:
            return 2
        code, h = model.calibrate(rule, samples)
        print(json.dumps({"rule": rule, "exit": code, "h": h, "note": "H_sample은 경계 확인용이며 실제 H는 사실상 모형 하한"}, ensure_ascii=False))
        return code
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


def cmd_rag_prepare(argv):
    sdir, project = _opt(argv, "--session"), _opt(argv, "--project")
    if not sdir or not project or not os.path.isdir(sdir):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    import _mon_env
    ok, labels = _mon_env.db_target_check(project)
    if not ok:
        print(f"DB 대상 확인 실패: 5432 게시 컨테이너의 프로젝트 레이블 {labels} (기대: [{project}] 정확히 1개)", file=sys.stderr)
        return 1
    meta = json.load(open(os.path.join(sdir, "jar.json"), encoding="utf-8"))
    docs = os.path.join(sdir, "rag-docs")
    import shutil
    shutil.rmtree(docs, ignore_errors=True)
    shutil.copytree(os.path.join(ROOT, "docs", "rag-eval", "documents"), docs)  # 저장소 밖(세션 디렉터리)으로 복사해 색인한다
    code, out, (t0, t1) = _mon_env.run_jar_cli(meta["jar"], "indexer", ["--rebuild"], sdir, project, extra={"RAG_DOCS_DIR": docs, "RAG_ENABLED": "true"})
    print(json.dumps({"exit": code, "started": t0, "finished": t1, "tail": out.strip().splitlines()[-3:]}, ensure_ascii=False))
    return 0 if code == 0 else 1


def cmd_teardown(argv):
    project = _opt(argv, "--project")
    sdir = find_session(project or "")
    if not sdir:
        print("해당 프로젝트의 세션을 찾지 못했다.", file=sys.stderr)
        return 2
    p = s6("teardown", "--session", sdir, check=False)
    print((p.stdout + p.stderr).strip())
    return p.returncode


def main(argv):
    if argv[:1] == ["bench"]:
        import _mon_bench
        return _mon_bench.main(argv[1:], sys.modules[__name__])
    commands = {"alarm-up": cmd_alarm_up, "mgmt": cmd_mgmt, "spike": cmd_spike, "provision": cmd_provision, "replay": cmd_replay, "n8n-smoke": cmd_n8n_smoke, "stub": cmd_stub, "run": cmd_run,
                "override": cmd_override, "session": cmd_session, "rag-prepare": cmd_rag_prepare, "teardown": cmd_teardown}
    if not argv or argv[0] not in commands:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    return commands[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
