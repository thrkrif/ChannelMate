#!/usr/bin/env python3
"""코어 변경 0 검사(6단계 M44). `src/main/java/com/slack/lab/core` 아래가 바뀌면 exit 1, 아니면 0(사용법 오류 2).
사용: scripts/core-diff-check                  (develop...HEAD + 작업 트리·스테이징·추적 안 되는 새 파일)
      scripts/core-diff-check --range A..B     (그 범위만. 작업 트리는 보지 않는다)
      scripts/core-diff-check --repo <경로>    (단위 시험용: 다른 저장소를 검사한다)
6단계는 코어 diff 0이 합격 기준이다(ADR-9 경계). 주석 한 곳만 허용하는 어휘 분석 모드(--allow-comment)는 7단계가 추가한다.
"""
import os
import subprocess
import sys

CORE = "src/main/java/com/slack/lab/core"
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def git(repo, *args):
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or "git 실패")
    return [x for x in p.stdout.splitlines() if x.strip()]


def changed(repo, rng=None, base="develop"):
    if rng:
        return sorted(set(git(repo, "diff", "--name-only", rng, "--", CORE)))
    files = set(git(repo, "diff", "--name-only", f"{base}...HEAD", "--", CORE))
    files |= set(git(repo, "diff", "--name-only", "HEAD", "--", CORE))
    files |= set(git(repo, "ls-files", "--others", "--exclude-standard", "--", CORE))
    return sorted(files)


def main(argv):
    repo, rng, i = ROOT, None, 0
    while i < len(argv):
        if argv[i] == "--range" and i + 1 < len(argv):
            rng, i = argv[i + 1], i + 2
        elif argv[i] == "--repo" and i + 1 < len(argv):
            repo, i = argv[i + 1], i + 2
        else:
            print(__doc__.split("\n")[1], file=sys.stderr)
            return 2
    try:
        files = changed(repo, rng)
    except RuntimeError as e:
        print(f"오류: {e}", file=sys.stderr)
        return 2
    if files:
        print(f"코어 변경 {len(files)}건:")
        for f in files:
            print(f"  {f}")
        return 1
    print("코어 diff 0")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
