#!/usr/bin/env python3
"""6단계 기동 세션 도구(M44부터 모든 가벼운·중간·무거운 기동이 쓴다). 기동 한 번 = 전용 compose 프로젝트 + 세션 장부 + PID 장부이고,
종료는 **장부에 적힌 것만** 정확히 되돌린다. 사용자의 기본 스택(`slack-lab` 프로젝트 볼륨)과 장부 밖 프로세스는 건드리지 않는다.

사용: scripts/s6-session start --id <기동 ID> [--keep-volumes]    세션 디렉터리를 만들고 경로를 출력한다
      scripts/s6-session compose [--session D] -- <docker compose 인자>   쓰는 -f·--profile을 장부에 먼저 적고 같은 -p로 실행
      scripts/s6-session spawn [--session D] [--name N] [--env-file F ...] [--env K=V ...] -- <명령>   백그라운드 실행, PID 장부 기록
      scripts/s6-session mark  [--session D] monitoring|n8n              장부에 모니터링·n8n 사용을 표시한다
      scripts/s6-session status [--session D]
      scripts/s6-session teardown [--session D]                          종료 순서 1~8 (아래)
세션은 --session 또는 환경변수 S6_SESSION으로 고른다. 세션 루트는 S6_SESSION_ROOT(기본 <저장소>/.runtime/s6, gitignore).
프로젝트 이름은 `slack-lab-s6v-<기동 ID>`다. 같은 접두의 볼륨이 이미 있으면 시작을 거부한다(이전 기동의 데이터를 물려받지 않는다).

종료 순서: 1) 소유 프로세스 정지(TERM→10초→KILL, ./gradlew --stop) 2) 모니터링 정지(장부에 사용이 있을 때만)
3) 장부의 구성 그대로 down, 실패하면 레이블 기반 정리 4) 볼륨(기본 삭제, --keep-volumes면 보존·이름 기록)
5) n8n(장부에 사용이 있을 때만) 6) ollama 모델 정지 7) 최종 확인(컨테이너·네트워크·PID·리스너·ollama) 8) 알림 문구 출력.
종료 코드: 0 정상, 1 최종 확인 실패·거부, 2 사용법 오류.
"""
import datetime
import json
import os
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PREFIX = "slack-lab-s6v-"
LISTEN_PORTS = ("8080", "9091", "3000")
TERM_WAIT = float(os.environ.get("S6_TERM_WAIT", "10"))


def session_root():
    return os.environ.get("S6_SESSION_ROOT") or os.path.join(ROOT, ".runtime", "s6")


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(cmd, cwd=ROOT, check=False):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd[:3])} 실패: {p.stderr.strip()[:200]}")
    return p


def load(sdir):
    with open(os.path.join(sdir, "ledger.json"), encoding="utf-8") as f:
        return json.load(f)


def save(sdir, ledger):
    tmp = os.path.join(sdir, "ledger.json.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(ledger, f, ensure_ascii=False, indent=2)
    os.replace(tmp, os.path.join(sdir, "ledger.json"))


def pick_session(argv):
    sdir = None
    if "--session" in argv:
        i = argv.index("--session")
        sdir = argv[i + 1]
        del argv[i:i + 2]
    sdir = sdir or os.environ.get("S6_SESSION")
    if not sdir or not os.path.isfile(os.path.join(sdir, "ledger.json")):
        print("오류: 세션을 찾을 수 없다(--session 또는 S6_SESSION). 먼저 start를 실행한다.", file=sys.stderr)
        sys.exit(2)
    return sdir


def volumes(project):
    p = run(["docker", "volume", "ls", "-q", "--filter", f"label=com.docker.compose.project={project}"])
    by_label = [x for x in p.stdout.split() if x]
    p = run(["docker", "volume", "ls", "-q", "--filter", f"name=^{project}_"])
    return sorted(set(by_label) | {x for x in p.stdout.split() if x})


def cmd_start(argv):
    sid, keep = None, False
    i = 0
    while i < len(argv):
        if argv[i] == "--id" and i + 1 < len(argv):
            sid, i = argv[i + 1], i + 2
        elif argv[i] == "--keep-volumes":
            keep, i = True, i + 1
        else:
            print("사용: s6-session start --id <기동 ID> [--keep-volumes]", file=sys.stderr)
            return 2
    if not sid or not all(c.isalnum() or c in "-_" for c in sid):
        print("오류: 기동 ID는 영숫자·-·_만 쓴다.", file=sys.stderr)
        return 2
    project = PREFIX + sid.lower()
    stale = volumes(project)
    if stale:
        print(f"거부: 같은 접두({project}_)의 볼륨이 이미 있다 — 이전 기동의 데이터를 물려받지 않는다.", file=sys.stderr)
        for v in stale:
            print(f"  {v}", file=sys.stderr)
        return 1
    sdir = os.path.join(session_root(), f"{sid}-{time.strftime('%Y%m%d-%H%M%S')}")
    os.makedirs(sdir)
    save(sdir, {"id": sid, "project": project, "dir": sdir, "keep_volumes": keep, "started_at": now(),
                "compose": [], "files": [], "profiles": [], "monitoring": False, "n8n": False, "pids": []})
    print(sdir)
    return 0


def compose_prefix(args):
    """서브커맨드 앞의 -f/--file/--profile/--env-file을 모은다(`up -d …` 같은 서브커맨드부터는 보지 않는다)."""
    files, profiles, rest_at, i = [], [], 0, 0
    while i < len(args):
        a = args[i]
        if a in ("-f", "--file") and i + 1 < len(args):
            files.append(args[i + 1]); i += 2
        elif a == "--profile" and i + 1 < len(args):
            profiles.append(args[i + 1]); i += 2
        elif a.startswith("-"):
            i += 1
        else:
            break
    return files, profiles


def cmd_compose(argv):
    sdir = pick_session(argv)
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv:
        print("사용: s6-session compose [--session D] -- <docker compose 인자>", file=sys.stderr)
        return 2
    ledger = load(sdir)
    files, profiles = compose_prefix(argv)
    for f in files:
        if f not in ledger["files"]:
            ledger["files"].append(f)
        if "monitoring" in os.path.basename(f):
            ledger["monitoring"] = True
    for p in profiles:
        if p not in ledger["profiles"]:
            ledger["profiles"].append(p)
        if p == "monitoring":
            ledger["monitoring"] = True
    ledger["compose"].append({"at": now(), "args": argv})
    save(sdir, ledger)  # 실행하기 전에 먼저 적는다
    return subprocess.run(["docker", "compose", "-p", ledger["project"], *argv], cwd=ROOT).returncode


def read_env_file(path):
    env = {}
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def cmd_spawn(argv):
    sdir = pick_session(argv)
    name, env_files, extra = None, [], {}
    while argv and argv[0] != "--":
        if argv[0] == "--name" and len(argv) > 1:
            name = argv[1]; argv = argv[2:]
        elif argv[0] == "--env-file" and len(argv) > 1:
            env_files.append(argv[1]); argv = argv[2:]  # 여러 개면 뒤의 파일이 앞을 덮는다(비밀을 argv에 싣지 않고 회전 값을 얹는 용도)
        elif argv[0] == "--env" and len(argv) > 1 and "=" in argv[1]:
            k, v = argv[1].split("=", 1); extra[k] = v; argv = argv[2:]
        else:
            print("사용: s6-session spawn [--session D] [--name N] [--env-file F] [--env K=V] -- <명령>", file=sys.stderr)
            return 2
    cmd = argv[1:]
    if not cmd:
        print("오류: 실행할 명령이 없다.", file=sys.stderr)
        return 2
    ledger = load(sdir)
    name = name or os.path.basename(cmd[0])
    # .env를 먼저 읽고 그 뒤에 세션 값을 덮어쓴다(셸 export 순서에 기대지 않는다)
    env = dict(os.environ)
    for env_file in env_files:
        env.update(read_env_file(env_file))
    env["SLACK_LAB_LOG_DIR"] = sdir
    env.update(extra)
    log = open(os.path.join(sdir, f"{name}.log"), "ab")
    proc = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                            start_new_session=True)
    ledger["pids"].append({"pid": proc.pid, "name": name, "started_at": now(), "cmd": os.path.basename(cmd[0])})
    save(sdir, ledger)
    print(proc.pid)
    return 0


def cmd_mark(argv):
    sdir = pick_session(argv)
    if argv not in (["monitoring"], ["n8n"]):
        print("사용: s6-session mark [--session D] monitoring|n8n", file=sys.stderr)
        return 2
    ledger = load(sdir)
    ledger[argv[0]] = True
    save(sdir, ledger)
    return 0


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # 좀비는 종료된 것으로 본다
    p = run(["ps", "-o", "stat=", "-p", str(pid)])
    return bool(p.stdout.strip()) and not p.stdout.strip().startswith("Z")


def stop_pids(ledger):
    pids = [e["pid"] for e in ledger["pids"] if alive(e["pid"])]
    for pid in pids:
        try:
            signal_owned(ledger, pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.time() + TERM_WAIT
    while time.time() < deadline and any(alive(p) for p in pids):
        time.sleep(0.2)
    for pid in pids:
        if alive(pid):
            try:
                signal_owned(ledger, pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    time.sleep(0.2)
    gradlew = os.environ.get("S6_GRADLEW", "./gradlew")
    run([gradlew, "--stop"])


def signal_owned(ledger, pid, sig):
    # Gradle 데몬이 만든 앱 JVM은 spawn의 프로세스 그룹을 물려받지 않을 수 있다.
    direct = any(e["pid"] == pid and e.get("signal_pid") for e in ledger["pids"])
    (os.kill if direct else os.killpg)(pid, sig)


def label_cleanup(project):
    cs = run(["docker", "ps", "-aq", "--filter", f"label=com.docker.compose.project={project}"]).stdout.split()
    if cs:
        run(["docker", "rm", "-f", *cs])
    ns = run(["docker", "network", "ls", "-q", "--filter", f"label=com.docker.compose.project={project}"]).stdout.split()
    if ns:
        run(["docker", "network", "rm", *ns])


def compose_cmd(ledger, *tail):
    cmd = ["docker", "compose", "-p", ledger["project"]]
    for f in ledger["files"]:
        cmd += ["-f", f]
    for p in ledger["profiles"]:
        cmd += ["--profile", p]
    return cmd + list(tail)


def listeners():
    p = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"])
    found = set()
    for line in p.stdout.splitlines():
        for port in LISTEN_PORTS:
            if f":{port} " in line + " " or line.rstrip().endswith(f":{port}"):
                found.add(port)
    return sorted(found)


def cmd_teardown(argv):
    sdir = pick_session(argv)
    ledger = load(sdir)
    project = ledger["project"]
    notes = []
    # 1) 소유 프로세스 정지
    stop_pids(ledger)
    # 2) 모니터링 정지 (장부에 사용이 있을 때만)
    if ledger["monitoring"]:
        env = dict(os.environ, SLACK_LAB_COMPOSE_PROJECT=project)
        subprocess.run([os.path.join(ROOT, "scripts", "monitoring"), "stop"], cwd=ROOT, env=env)
    # 3) 장부의 구성 그대로 down. 장부에 compose 사용이 없으면 레이블 정리만 한다
    drop_volumes = not ledger["keep_volumes"]
    if ledger["compose"]:
        down = run(compose_cmd(ledger, "down", "--remove-orphans", *(["-v"] if drop_volumes else [])))
        if down.returncode != 0:
            notes.append("down 실패 → 레이블 기반 정리")
            label_cleanup(project)
    else:
        label_cleanup(project)
    label_cleanup(project)  # down이 성공했어도 남은 것이 없는지 한 번 더 비운다(레이블 한정)
    # 4) 볼륨
    kept = []
    if drop_volumes:
        if ledger["monitoring"]:
            subprocess.run([os.path.join(ROOT, "scripts", "monitoring"), "reset", "--confirm"], cwd=ROOT,
                           env=dict(os.environ, SLACK_LAB_COMPOSE_PROJECT=project))
        left = volumes(project)
        if left:
            run(["docker", "volume", "rm", *left])
    else:
        kept = volumes(project)
    # 5) n8n (장부에 사용이 있을 때만): 세션 프로젝트 안의 컨테이너와 스모크 볼륨만 — 위 레이블 정리가 이미 포함한다
    if ledger["n8n"]:
        notes.append("n8n 세션 컨테이너·스모크 볼륨 정리됨(사용자 볼륨 무접촉)")
    # 6) ollama
    ps = run(["ollama", "ps"])
    for line in ps.stdout.splitlines()[1:]:
        model = line.split()[0] if line.split() else ""
        if model:
            run(["ollama", "stop", model])
    # 7) 최종 확인
    problems = []
    cs = run(["docker", "ps", "-aq", "--filter", f"label=com.docker.compose.project={project}"]).stdout.split()
    ns = run(["docker", "network", "ls", "-q", "--filter", f"label=com.docker.compose.project={project}"]).stdout.split()
    if cs:
        problems.append(f"컨테이너 {len(cs)}개 남음")
    if ns:
        problems.append(f"네트워크 {len(ns)}개 남음")
    if drop_volumes and volumes(project):
        problems.append("볼륨 남음")
    live = [e for e in ledger["pids"] if alive(e["pid"])]
    if live:
        problems.append("살아 있는 프로세스: " + ", ".join(f"{e['name']}({e['pid']})" for e in live))
    ports = listeners()
    if ports:
        problems.append("리스너 남음: " + ",".join(ports))
    remaining = [x for x in run(["ollama", "ps"]).stdout.splitlines()[1:] if x.strip()]
    if remaining:
        problems.append("ollama 모델이 올라와 있음")
    result = {"project": project, "finished_at": now(), "kept_volumes": kept, "notes": notes, "problems": problems}
    with open(os.path.join(sdir, "result.json"), "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=2)
    if problems:
        print("종료 확인 실패:")
        for p in problems:
            print(f"  - {p}")
        return 1
    # 8) 확인이 끝난 뒤에만 알린다
    print("서버·컨테이너·모델을 모두 내렸다(남은 것 없음)" if not kept else
          "서버·컨테이너·모델을 모두 내렸다. 보존 볼륨: " + ", ".join(kept))
    for n in notes:
        print(f"  참고: {n}")
    return 0


def cmd_status(argv):
    sdir = pick_session(argv)
    ledger = load(sdir)
    print(json.dumps({k: ledger[k] for k in ("id", "project", "files", "profiles", "monitoring", "n8n", "keep_volumes")},
                     ensure_ascii=False))
    for e in ledger["pids"]:
        print(f"  pid {e['pid']} {e['name']} {'실행 중' if alive(e['pid']) else '종료'}")
    return 0


COMMANDS = {"start": cmd_start, "compose": cmd_compose, "spawn": cmd_spawn, "mark": cmd_mark, "teardown": cmd_teardown,
            "status": cmd_status}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
