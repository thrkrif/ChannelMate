#!/usr/bin/env python3
"""6단계 모니터링 스택 단일 진입(M46). Loki·Grafana·Prometheus·Alloy(compose.monitoring.yaml, 프로필 `monitoring`)를 켜고 끈다.

사용: scripts/monitoring start --host|--app    스택을 켠다(앱을 호스트에서 bootRun 중이면 --host, 컨테이너로 돌리면 --app)
      scripts/monitoring stop                  스택 컨테이너 4개를 멈추고 지운다(볼륨은 유지)
      scripts/monitoring reset --confirm       stop 뒤 이 프로젝트의 모니터링 볼륨 4개(`<프로젝트>_mon-*`)만 지운다
      scripts/monitoring status                컨테이너 상태

모든 조작은 `docker compose -p <프로젝트> -f compose.yaml -f compose.monitoring.yaml --profile monitoring …` 한 가지 형태다. 프로젝트는
SLACK_LAB_COMPOSE_PROJECT(기본 `slack-lab`)이며, S6_SESSION이 있으면 세션 장부의 프로젝트를 쓰고 compose 호출을 `s6-session compose`로
장부에 남긴다. 기본 스택의 볼륨을 지우는 호출(down의 볼륨 옵션)은 어디에서도 부르지 않는다(사용자의 Postgres·RabbitMQ 볼륨을 지킨다).

관리 토큰은 `.env`에서 메모리로만 읽어 `${SLACK_LAB_SECRET_DIR:-~/.slack-lab-secrets}/metrics_token`(600)에 쓴다. 출력하지 않고, 설정 파일
(prometheus.yml)에는 파일 경로만 있다. 저장소 안 `.runtime`은 iCloud 동기화 폴더에 있을 수 있어 비밀 파일 기본 위치로 쓰지 않는다.
호스트 모드(`--host`)에는 로그 파일 touch 보조 프로세스가 붙는다: Docker Desktop(macOS)의 bind mount는 호스트 프로세스가 **열어 둔 채로 가끔** 이어 쓰는 파일의
크기 변화를 컨테이너(Alloy)에 전달하지 못한다(M46 스파이크 발견 — 10초 간격 이어 쓰기가 컨테이너에 영원히 안 보임, 1초마다 mtime을 갱신하면 보임).
그래서 1초마다 역할별 로그 파일의 mtime만 갱신한다(내용·크기 무변경). `stop`이 끈다.
종료 코드: 0 정상, 1 실패, 2 사용법 오류.
"""
import json
import os
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ALERT_DIR = os.path.join("infra", "monitoring", "grafana", "provisioning", "alerting")
SERVICES = ("alloy", "loki", "prometheus", "grafana")
VOLUMES = ("mon-alloy", "mon-loki", "mon-prometheus", "mon-grafana")
FILES = ("compose.yaml", "compose.monitoring.yaml")
MODES = {
    "host": {"rules": "rules-host.json", "webhook": "http://host.docker.internal:8080/alerts/grafana"},
    "app": {"rules": "rules-app.json", "webhook": "http://receiver:8080/alerts/grafana"},
}


def env_file():
    """점검·토큰 읽기 대상. 시험이 임시 파일을 쓰도록 SLACK_LAB_ENV_FILE로 바꿀 수 있다(기본 저장소 루트의 .env)."""
    return os.environ.get("SLACK_LAB_ENV_FILE") or os.path.join(ROOT, ".env")


def read_env_value(key):
    path = env_file()
    value = ""
    if os.path.isfile(path):
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:].lstrip()
                if line.startswith(f"{key}=") and not line.startswith("#"):
                    value = line.split("=", 1)[1].strip().strip('"').strip("'")
    return value


def session_project():
    """S6_SESSION이 있으면 장부의 프로젝트. 없으면 None."""
    sdir = os.environ.get("S6_SESSION")
    if not sdir:
        return None
    with open(os.path.join(sdir, "ledger.json"), encoding="utf-8") as f:
        return json.load(f)["project"]


def project_name():
    return session_project() or os.environ.get("SLACK_LAB_COMPOSE_PROJECT") or "slack-lab"


def secret_dir():
    d = os.environ.get("SLACK_LAB_SECRET_DIR") or os.path.expanduser("~/.slack-lab-secrets")
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)
    return d


def mon_dir(project):
    d = os.environ.get("SLACK_LAB_MON_DIR") or os.path.join(ROOT, ".runtime", "monitoring", project)
    os.makedirs(os.path.join(d, "targets"), exist_ok=True)
    return d


def compose_args(*args):
    base = []
    for f in FILES:
        base += ["-f", f]
    return base + ["--profile", "monitoring", *args]


def compose(project, args, env, via_session):
    """프로젝트에 대한 docker compose 호출. 세션 안이면 장부에 먼저 적는 s6-session을 거친다."""
    if via_session:
        cmd = [os.path.join(ROOT, "scripts", "s6-session"), "compose", "--", *compose_args(*args)]
    else:
        cmd = ["docker", "compose", "-p", project, *compose_args(*args)]
    return subprocess.run(cmd, cwd=ROOT, env=env).returncode


ROLES = ("receiver", "worker", "reactor", "all")


def log_dir_host():
    return os.environ.get("SLACK_LAB_LOG_DIR_HOST") or os.path.join(ROOT, ".runtime", "logs")


def touch_pidfile(mdir):
    return os.path.join(mdir, "touch.pid")


def stop_touch(mdir):
    path = touch_pidfile(mdir)
    if not os.path.isfile(path):
        return
    try:
        pid = int(open(path).read().strip())
        os.killpg(pid, signal.SIGTERM)
    except (ValueError, ProcessLookupError, PermissionError):
        pass
    try:
        os.remove(path)
    except OSError:
        pass


def cmd_touch_loop(argv):
    """(내부) 1초마다 로그 파일 mtime을 갱신한다. PID 파일이 사라지거나 다른 PID를 가리키면 끝난다."""
    if len(argv) != 2:
        return 2
    directory, pidfile = argv
    me = str(os.getpid())
    while True:
        try:
            if open(pidfile).read().strip() != me:
                return 0
        except OSError:
            return 0
        for role in ROLES:
            path = os.path.join(directory, role, "slack-lab.log")
            try:
                os.utime(path, None)
            except OSError:
                pass
        time.sleep(1)


def start_touch(mdir):
    stop_touch(mdir)
    proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "touch-loop", log_dir_host(), touch_pidfile(mdir)],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    with open(touch_pidfile(mdir), "w") as f:
        f.write(str(proc.pid))


def targets_for(mode, port):
    if mode == "host":
        return [{"targets": [f"host.docker.internal:{port}"], "labels": {"role": "all"}}]
    return [{"targets": [f"{role}:{port}"], "labels": {"role": role}} for role in ("receiver", "worker", "reactor")]


def write_secret(directory, name, value):
    path = os.path.join(directory, name)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value)
    os.chmod(path, 0o600)
    return path


def cmd_start(argv):
    if argv not in (["--host"], ["--app"]):
        print("사용: scripts/monitoring start --host|--app", file=sys.stderr)
        return 2
    mode = argv[0][2:]
    # 시작 전 점검: 토큰 형식·재사용 금지·바인딩(값은 출력하지 않는다)
    chk = subprocess.run([os.path.join(ROOT, "scripts", "env-check"), env_file(), "--monitoring", "--mode", mode], cwd=ROOT,
                         capture_output=True, text=True)
    if chk.returncode != 0:
        print(chk.stdout.strip() or chk.stderr.strip())
        return 1
    project = project_name()
    token = read_env_value("MANAGEMENT_METRICS_TOKEN")
    if not token:
        print("오류 MANAGEMENT_METRICS_TOKEN: 비어 있다 — .env에 넣는다(scripts/env-check --monitoring 참고)")
        return 1
    secrets_dir = secret_dir()
    write_secret(secrets_dir, "metrics_token", token)  # 값은 출력하지 않는다
    mdir = mon_dir(project)
    port = os.environ.get("MANAGEMENT_SERVER_PORT") or read_env_value("MANAGEMENT_SERVER_PORT") or "9091"
    with open(os.path.join(mdir, "targets", "targets.json"), "w", encoding="utf-8") as f:
        json.dump(targets_for(mode, port), f, indent=2)
    rules = os.path.join(ROOT, ALERT_DIR, MODES[mode]["rules"])
    env = dict(os.environ)
    env.update({
        "SLACK_LAB_COMPOSE_PROJECT": project,
        "SLACK_LAB_SECRET_DIR": secrets_dir,
        "SLACK_LAB_MON_DIR": mdir,
        "SLACK_LAB_RULES_FILE": rules,
        "GRAFANA_ALERT_WEBHOOK_URL": os.environ.get("GRAFANA_ALERT_WEBHOOK_URL") or MODES[mode]["webhook"],
    })
    # 모드가 바뀌었으면 규칙 마운트가 달라지므로 Grafana 컨테이너를 새로 만든다(옛 규칙 파일이 남는 것을 막는다)
    last_path = os.path.join(mdir, "mode")
    last = open(last_path).read().strip() if os.path.isfile(last_path) else ""
    via = session_project() is not None
    if last and last != mode:
        compose(project, ["rm", "-s", "-f", "grafana"], env, via)
    rc = compose(project, ["up", "-d", *SERVICES], env, via)
    if rc == 0:
        with open(last_path, "w") as f:
            f.write(mode)
        if mode == "host":
            start_touch(mdir)
        else:
            stop_touch(mdir)
        if via:
            subprocess.run([os.path.join(ROOT, "scripts", "s6-session"), "mark", "monitoring"], cwd=ROOT)
        print(f"모니터링 스택 시작({mode} 모드, 프로젝트 {project}). Grafana: http://127.0.0.1:3000")
    return rc


def direct_env(project):
    env = dict(os.environ)
    env["SLACK_LAB_COMPOSE_PROJECT"] = project
    return env


def cmd_stop(argv):
    if argv:
        print("사용: scripts/monitoring stop", file=sys.stderr)
        return 2
    project = project_name()
    stop_touch(mon_dir(project))
    return compose(project, ["rm", "-s", "-f", *SERVICES], direct_env(project), False)


def cmd_reset(argv):
    if argv != ["--confirm"]:
        print("사용: scripts/monitoring reset --confirm   (이 프로젝트의 모니터링 볼륨 4개만 지운다)", file=sys.stderr)
        return 2
    project = project_name()
    stop_touch(mon_dir(project))
    rc = compose(project, ["rm", "-s", "-f", *SERVICES], direct_env(project), False)
    names = [f"{project}_{v}" for v in VOLUMES]
    existing = subprocess.run(["docker", "volume", "ls", "-q"], capture_output=True, text=True).stdout.split()
    target = [n for n in names if n in existing]
    if target:
        subprocess.run(["docker", "volume", "rm", *target], capture_output=True, text=True)
    return rc


def cmd_status(argv):
    project = project_name()
    return compose(project, ["ps"], direct_env(project), False)


def main(argv):
    commands = {"start": cmd_start, "stop": cmd_stop, "reset": cmd_reset, "status": cmd_status, "touch-loop": cmd_touch_loop}
    if not argv or argv[0] not in commands:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    return commands[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
