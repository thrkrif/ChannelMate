{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "slack-lab-null",
      "receivers": [
        {
          "uid": "slack-lab-null",
          "type": "email",
          "disableResolveMessage": true,
          "settings": {
            "addresses": "nobody@invalid.example"
          }
        }
      ]
    },
    {
      "orgId": 1,
      "name": "slack-lab-webhook",
      "receivers": [
        {
          "uid": "slack-lab-webhook",
          "type": "webhook",
          "disableResolveMessage": false,
          "settings": {
            "url": "${GRAFANA_ALERT_WEBHOOK_URL}",
            "httpMethod": "POST",
            "headers": {
              "X-Alert-Secret": "$__env{ALERT_SECRET}"
            }
          }
        }
      ]
    }
  ]
}
