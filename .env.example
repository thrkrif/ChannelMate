# 채운 뒤 기동 전에 `scripts/env-check`로 점검한다(값은 출력하지 않고 키 이름·사유만 알려준다. RAG 색인 CLI 전에는 --index).
# 키 이름만 적는다. 실제 값은 .env에 넣고 커밋하지 않는다.
# Spring relaxed binding: SLACK_BOT_TOKEN -> slack.bot-token
# 아래 세 키는 필수다. 비어 있으면 기동이 실패한다(A3).
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# 모델 ID는 `ollama list` 결과를 쓴다 (추측 금지). 필수. 16GB 노트북 권장: qwen2.5:3b (M30 실측 합격, 7b는 선택).
LLM_MODEL=

# 선택. 값을 주지 않으면 기본값(http://localhost:11434/v1)을 쓴다.
# 빈 값으로 두면 기본값이 아니라 빈 값이 적용돼 기동이 실패하므로 주석 처리해 둔다.
# LLM_BASE_URL=

# 2단계 (선택). 역할: receiver | worker | reactor | recovery | all(기본). compose는 서비스마다 따로 지정한다.
# APP_ROLE=
# Postgres 비밀번호. 기본값이 없다 — compose의 postgres와 앱이 같은 값을 쓴다. 필수(워커·복구).
POSTGRES_PASSWORD=
# 접속 대상. 기본 localhost(호스트 bootRun), compose 컨테이너에서는 서비스 이름으로 덮어쓴다.
# POSTGRES_URL=
# RABBITMQ_HOST=
# compose 수신 컨테이너의 호스트 포트(기본 8080). 8080이 이미 쓰이고 있으면 바꾼다.
# RECEIVER_PORT=
# 알람 직접 수신(M23, 선택). 둘 다 채워야 /alerts/{source}가 켜진다. 시크릿은 URL(token=)이나 X-Alert-Secret 헤더로 보낸다.
# ALERT_SECRET=
# ALERT_CHANNEL=
# 실험·429 관측용 테스트 채널 ID. 공개 저장소이므로 문서에는 적지 않는다.
SLACK_TEST_CHANNEL=

# 3단계 RAG (선택, 기본 꺼짐). 켜면 모델 ID(`ollama list`)와 차원이 필요하다. 외부 엔드포인트는 허용 플래그를 켜야 기동한다.
# RAG_ENABLED=
# RAG_EMBEDDING_MODEL=
# RAG_EMBEDDING_DIMENSION=
# RAG_EMBEDDING_BASE_URL=
# RAG_ALLOW_EXTERNAL_EMBEDDING=
# RAG_ALLOW_EXTERNAL_LLM=
# 검색 튜닝(기본 0.54·1500은 M30 실측값. 바꾸면 tuning 세트로만 다시 정한다): RAG_RETRIEVAL_MIN_SCORE, RAG_RETRIEVAL_MAX_CONTEXT_CHARS, RAG_RETRIEVAL_TOP_K
# 컨테이너(--profile app)에서 임베딩 서버 주소를 바꿀 때만: RAG_EMBEDDING_BASE_URL_CONTAINER
# 색인 CLI(scripts/rag-index). 문서 디렉터리는 저장소 밖 경로여야 한다(공개 저장소에 실제 문서를 커밋하지 않는다).
# RAG_DOCS_DIR=

# 4단계 요청 분류(기본 꺼짐). 켜면 모델 ID 필수(ollama list). 답변 모델과 같게 두면 16GB에서도 모델 재적재가 없다.
# CLASSIFICATION_ENABLED=false
# CLASSIFICATION_MODEL=
